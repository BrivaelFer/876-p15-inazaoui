    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Docker",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/var/www/html": "${workspaceFolder}"
            },
            "xdebugSettings": {
                "max_children": 500,
                "max_data": 1024,
                "max_depth": 5
            }
        },
        {
            "name": "Listen for symfony server",
            "type": "php",
            "request": "launch",
            "port": 9003
        }
    ]
}